{
  "name": "@onetodone/short-link-api",
  "version": "2.0.0",
  "description": "High-performance URL shortener API (NestJS + Fastify + Prisma + Redis)",
  "private": true,
  "author": "Anton Holubeu (https://github.com/aholu)",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"prisma/**/*.ts\" vitest.config.mts",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"prisma/**/*.ts\" vitest.config.mts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "loadtest:seed": "tsx scripts/seed-loadtest.ts",
    "loadtest": "tsx scripts/load-test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "link:disable": "node dist/src/cli/moderation link:disable",
    "link:enable": "node dist/src/cli/moderation link:enable",
    "user:suspend": "node dist/src/cli/moderation user:suspend",
    "user:unsuspend": "node dist/src/cli/moderation user:unsuspend",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/proxy-addr": "^5.1.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@onetodone/mailer": "^0.3.8",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "5.12.1",
    "ioredis": "^6.0.0",
    "isbot": "^5.2.2",
    "nestjs-pino": "^5.1.0",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@swc/core": "1.16.18",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "autocannon": "^8.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "~6",
    "typescript-eslint": "^8.69.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
