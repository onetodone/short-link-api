# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Optional secret for signing/verifying cookies via @fastify/cookie
COOKIE_SECRET=

# Which peers may set X-Forwarded-For (the client IP used by rate limits, sessions and logs).
#   private (default) — trust a reverse proxy on loopback or a private network
#                       (nginx on the same host, the front's Next proxy); any other
#                       peer gets its socket address.
#   all               — trust every peer, for a proxy on a public address (a CDN).
#   none              — trust no peer.
TRUSTED_PROXY=private
# Shared secret of a frontend that proxies API calls from a host with changing addresses (Vercel).
# Requests carrying it in x-proxy-secret are identified by their x-client-ip. Same value as the
# frontend's API_PROXY_SECRET; at least 32 characters (openssl rand -hex 32). Empty turns it off.
FRONT_PROXY_SECRET=

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:[USER]@localhost:5432/short_url?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to true for managed providers that require TLS (e.g. Upstash: rediss://). Leave false for local Docker.
REDIS_TLS=false

# Logging
# Slow Prisma query threshold in milliseconds (queries >= this value are warned)
SLOW_QUERY_THRESHOLD_MS=200
# Pino log level (trace|debug|info|warn|error|fatal); defaults to debug in dev, info in prod
LOG_LEVEL=debug

# Short Link service
# Base URL used to build the short link returned by POST /api/v1/urls
SHORT_URL_BASE=http://localhost:3000
# Length of the generated base62 short code
SHORT_CODE_LENGTH=7
# Retries on a unique-collision before giving up when minting a code
SHORT_CODE_MAX_RETRIES=5
# Status of GET /:shortCode (301|302). 302 (default) is sent with Cache-Control: private, max-age=0,
# so every visit reaches the service: edited destinations apply at once and repeat clicks are counted.
# Browsers cache a 301 indefinitely.
REDIRECT_STATUS=302
# Links one account may create per 24 h window (0 turns the quota off)
URL_CREATE_DAILY_LIMIT=10

# Email
# Public URL of the frontend. Links in emails point to its /verify-email and /reset-password pages.
APP_URL=http://localhost:3001
# Support address shown in the footer of every email
SUPPORT_EMAIL=support@example.com
# SMTP server that delivers account emails (required). Sending never delays a response; failures are
# logged and the user can ask for the email again.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Connection encryption. Both take true/1, false/0 or empty.
#   SMTP_SECURE=true      — connects over TLS from the start (port 465). Empty means true on port 465 only.
#   SMTP_REQUIRE_TLS=true — fails unless the server upgrades the connection via STARTTLS (port 587).
# With neither, STARTTLS is used only when the server offers it, so mail and credentials can go out
# unencrypted.
SMTP_SECURE=
SMTP_REQUIRE_TLS=
# "From" address and name of outgoing email. The address defaults to SMTP_USER.
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="Short Link"

# Cache / Redis tuning
# Positive cache TTL for a resolved short code (seconds)
CACHE_TTL_SECONDS=3600
# Negative cache TTL for an unknown short code (seconds) — protects the DB from scans
CACHE_NEGATIVE_TTL_SECONDS=60
# Stampede lock TTL for a single cache fill (milliseconds)
CACHE_LOCK_TTL_MS=3000
# Prefix applied to every Redis key
REDIS_KEY_PREFIX=shortlink:
# How often the buffered click counters are flushed to Postgres (milliseconds)
CLICKS_FLUSH_INTERVAL_MS=5000

# Rate limiting (@nestjs/throttler)
# THROTTLE_TTL: sliding window in milliseconds
# THROTTLE_LIMIT: max requests per window
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# JWT / sessions — generate a strong secret with: node -e "require('crypto').randomBytes(64).toString('hex')"
# JWT_SECRET signs the stateless access token. JWT_REFRESH_EXPIRES_IN is the refresh session's TTL.
JWT_SECRET=change-me-to-a-strong-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# How often expired refresh sessions are swept from the database (ms, min 60000)
SESSION_CLEANUP_INTERVAL_MS=3600000

# Google Safe Browsing API key: create one in a Google Cloud project with the
# "Safe Browsing API" enabled, restricted to that API. Destinations are checked
# when saved and re-checked after redirects; flagged links are disabled.
# Empty turns the checks off. Safe Browsing is for non-commercial use only; a
# commercial service needs Google Web Risk instead.
SAFE_BROWSING_API_KEY=
